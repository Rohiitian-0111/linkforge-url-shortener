# Run: python scripts/setup.py
# It creates .env with fresh secrets and preserves any existing .env.
POSTGRES_USER=linkforge
POSTGRES_DB=linkforge
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
REDIS_PASSWORD=GENERATE_WITH_SETUP
JWT_SECRET=GENERATE_WITH_SETUP
METRICS_TOKEN=GENERATE_WITH_SETUP

# Local Docker defaults. PUBLIC_BASE_URL is where visitors open short links.
ENVIRONMENT=production
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_PORT=8080
FRONTEND_BIND=0.0.0.0
API_PORT=8000
REDIS_MAXMEMORY=256mb
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]
CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20
CREATE_RATE_LIMIT=100
ANALYTICS_MODE=stream
